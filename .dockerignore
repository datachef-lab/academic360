# VCS
.git
.gitignore

# Node / pnpm
# `node_modules` alone only matches the ROOT directory — nested ones
# (apps/*/node_modules) still enter the build context, get carried through
# `turbo prune` into out/full, and then collide with the freshly installed
# tree ("cannot copy to non-directory"). CI never hits this because it builds
# from a clean checkout; a developer building locally always would.
node_modules
**/node_modules
.pnpm-store
.pnp*

# Build outputs
apps/**/dist
apps/**/.next
apps/**/.turbo
.turbo

# Logs
*.log
apps/**/logs

# Env files (keep on servers only)
.env
.env.*

# Editor/OS
.DS_Store
.vscode
.idea

# Misc
coverage
**/uploads
**/public/temp


dist
.env*
logs
.turbo
!packages/db/dist

# Build-time env files the frontends bake in (no secrets beyond what ships
# to browsers anyway); everything else in .env* stays excluded.
!apps/student-console/.env.production
!apps/main-console/.env.local